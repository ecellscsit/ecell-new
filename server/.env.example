PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string. Use ONE of these:
#  A) Local MongoDB (default):   mongodb://127.0.0.1:27017/ecell_scsit
#  B) Atlas (cloud, free):       mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ecell_scsit?retryWrites=true&w=majority
#     - replace USERNAME and PASSWORD (no < > brackets); keep /ecell_scsit as the database name
#     - password with symbols? encode them: @ = %40   # = %23   / = %2F   : = %3A
MONGO_URI=mongodb://127.0.0.1:27017/ecell_scsit

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=7d

# First admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@ecellscsit.com
ADMIN_PASSWORD=Admin@12345

# LOCAL TESTING: skip email verification so you can register and log in immediately.
# Set to false (or delete) in production.
DEV_AUTO_VERIFY=true

# Email service (optional while developing: emails are printed in the terminal if empty)
# Works with Brevo, SendGrid, Resend SMTP, or Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Cell SCSIT <no-reply@yourdomain.com>"
# Contact-form messages are also forwarded here (optional)
ECELL_INBOX=
